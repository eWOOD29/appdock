+def _private_path_flavor(value: Any) -> str | None:
+    try:
+        normalize_windows_external_directory(value)
+        return "windows"
+    except AppDockError:
+        pass
+    try:
+        _normalize_posix_external_directory(value)
+        return "posix"
+    except AppDockError:
+        return None
